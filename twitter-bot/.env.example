# Twitter API v2 Credentials
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Twitter API v2 User Context (for write operations - get from your developer portal)
# Make sure these have write permissions (tweet, follow, like, retweet)
TWITTER_CLIENT_ID=your_client_id_here
TWITTER_CLIENT_SECRET=your_client_secret_here

# Optional: Redis connection for BullMQ (rate limiting and scheduling)
# If not provided, uses in-memory queue (simpler but no persistence)
REDIS_URL=redis://localhost:6379

# Bot Configuration
BOT_ENABLED=true
DRY_RUN=false
CHECK_INTERVAL_MINUTES=15
MAX_TWEETS_PER_DAY=50
MAX_FOLLOWS_PER_DAY=100
MAX_RETWEETS_PER_DAY=100
MAX_LIKES_PER_DAY=200

# Target Keywords (comma-separated)
TARGET_KEYWORDS=AI vision,computer vision,artificial intelligence,SaaS,startup,MVP,product launch,tech startup

# Announcement Template
ANNOUNCEMENT_TEMPLATE=🚀 Excited to announce that {product_name} is now live! {description} Check it out: {link} #AI #SaaS #MVP

# Logging
LOG_LEVEL=info