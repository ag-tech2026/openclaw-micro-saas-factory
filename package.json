{
  "name": "nextjs-mvp-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "a11y": "ts-node scripts/a11y-test.ts",
    "openclaw": "npx ts-node bin/openclaw.ts",
    "db:migrate": "drizzle-kit generate:pg && drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/lib/seed-subscription-db.ts",
    "sentry:login": "sentry-cli login",
    "sentry:release": "sentry-cli releases new $(git rev-parse --short HEAD) && sentry-cli releases files $(git rev-parse --short HEAD) upload-sourcemaps .next && sentry-cli releases finalize $(git rev-parse --short HEAD)",
    "sentry:verify": "node scripts/verify-sentry.js"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^8.34.0",
    "autoprefixer": "^10.4.27",
    "bcrypt": "^5.1.1",
    "better-auth": "^1.5.4",
    "commander": "^14.0.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "0.45.1",
    "esbuild": "^0.27.3",
    "fast-csv": "^5.0.5",
    "form-data": "^4.0.0",
    "inngest": "^3.52.6",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "15.2.8",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "rate-limiter-flexible": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^2.9.3",
    "recharts": "^3.8.0",
    "resend": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^14.22.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.25",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "axe-core": "^4.11.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
