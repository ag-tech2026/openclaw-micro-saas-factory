# Environment Configuration
# Copy this file to .env.local and fill in the values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Admin Authentication
# Shared secret for admin endpoints (analytics, usage). Change this in production!
RATE_LIMIT_ADMIN_SECRET=change-me-admin-secret

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# Sentry Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token
# Performance tracing sample rate (0.0 to 1.0). 0.1 = 10% of transactions
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: Override Sentry DSN for client-side only (if different)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_ENABLE_ERROR_MONITORING=true

# AI Vision API (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key

# Twitter API (v2)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Buffer API (optional - for scheduling across multiple platforms)
BUFFER_API_KEY=your-buffer-api-key

# Polar (payment/subscriptions - optional)
POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# BetterAuth (authentication)
BETTER_AUTH_SECRET=generate-a-random-32-byte-secret

# Neon DB (PostgreSQL) for subscription analytics
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# App-specific features
ENABLE_ANALYTICS=true
ENABLE_ERROR_MONITORING=true